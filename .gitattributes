# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Java, Gradle, Kotlin
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.gradle text eol=lf

# Python
*.py text eol=lf
*.pyi text eol=lf
requirements*.txt text eol=lf
*.toml text eol=lf
*.cfg text eol=lf

# JavaScript/TypeScript
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
package*.json text eol=lf
*.lock text eol=lf
vite*.config* text eol=lf

# Web
*.html text eol=lf
*.css text eol=lf
*.svg text eol=lf

# Config / docs
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.jar binary
*.class binary
*.DS_Store binary
